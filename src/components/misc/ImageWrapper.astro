---
interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	widths?: number[];
	sizes?: string;
}

import { Image } from "astro:assets";
import { resolveImage } from "../../utils/image-utils";

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	widths,
	sizes,
} = Astro.props;
const className = Astro.props.class;

const img = await resolveImage(src, basePath);

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

const responsiveImageProps = {
	alt: alt || "",
	class: imageClass,
	style: imageStyle,
	...(widths ? { widths } : {}),
	...(sizes ? { sizes } : {}),
};
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {typeof img !== "string" && <Image src={img} {...responsiveImageProps}/>}
    {typeof img === "string" && <img src={img} alt={alt || ""} class={imageClass} style={imageStyle}/>}
</div>
