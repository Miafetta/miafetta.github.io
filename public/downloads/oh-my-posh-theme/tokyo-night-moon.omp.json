{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "prompt-dark": "#1B1D2B",
    "frame-gray": "#828BB8",
    "path-blue": "#82AAFF",
    "git-clean": "#C3E88D",
    "git-modified": "#FFC777",
    "git-conflict": "#FF757F",
    "git-ahead": "#86E1FC",
    "runtime-purple": "#BB9AF7",
    "accent-orange": "#FF966C"
  },
  "transient_prompt": {
    "foreground": "p:git-clean",
    "background": "transparent",
    "template": "\u276f  "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:frame-gray",
          "background": "transparent",
          "template": "\u256d\u2500"
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:frame-gray",
          "background": "p:frame-gray",
          "template": "\u2588"
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:prompt-dark",
          "background": "p:frame-gray",
          "template": " {{ if .WSL }}WSL at {{ end }}{{ .Icon }} "
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:frame-gray",
          "background": "p:frame-gray",
          "template": "\u2588"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:prompt-dark",
          "background": "p:path-blue",
          "template": " \uf015  {{ .Path }} ",
          "options": {
            "style": "full",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "p:prompt-dark",
          "background": "p:git-clean",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-modified{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-conflict{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-clean{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "options": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:path-blue",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} \ue718 ",
          "options": {
            "display_mode": "files",
            "fetch_package_manager": true,
            "fetch_version": true
          },
          "cache": {
            "duration": "5m",
            "strategy": "session"
          }
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:git-ahead",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue627 ",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "julia",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:runtime-purple",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue624 ",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:git-modified",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue235 ",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "ruby",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:git-conflict",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \ue791 ",
          "options": {
            "display_mode": "files",
            "fetch_version": true
          }
        },
        {
          "type": "azfunc",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:git-clean",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} \uf0e7 ",
          "options": {
            "display_mode": "files",
            "fetch_version": false
          }
        },
        {
          "type": "aws",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:accent-orange",
          "background_templates": [
            "{{ if contains \"default\" .Profile }}p:git-modified{{ end }}",
            "{{ if contains \"jan\" .Profile }}p:git-conflict{{ end }}"
          ],
          "template": " {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} \ue7ad ",
          "options": {
            "display_default": false
          }
        },
        {
          "type": "root",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:git-conflict",
          "template": " \uf0ad "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:frame-gray",
          "template": " {{ .FormattedMs }} \uf252 ",
          "options": {
            "threshold": 500
          }
        },
        {
          "type": "status",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:git-clean",
          "background": "p:prompt-dark",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:prompt-dark{{ end }}"
          ],
          "background_templates": [
            "{{ if gt .Code 0 }}p:git-conflict{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }}\uf00d {{ reason .Code }}{{ else }}\uf00c{{ end }} ",
          "options": {
            "always_enabled": true
          }
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "p:prompt-dark",
          "background": "p:frame-gray",
          "template": " at {{ .CurrentDate | date .Format }} \uf017 ",
          "options": {
            "time_format": "15:04:05"
          }
        },
        {
          "type": "text",
          "style": "powerline",
          "foreground": "p:frame-gray",
          "background": "p:frame-gray",
          "template": "\u2588"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame-gray",
          "background": "transparent",
          "template": "\u2500\u256e"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame-gray",
          "template": "\u2570\u2500 "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:frame-gray",
          "template": "\u2500\u256f"
        }
      ]
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}
